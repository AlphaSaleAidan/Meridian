# Slim, laptop-friendly image to verify the live-camera path (no GPU/torch/YOLO).
# Bundles a static ffmpeg >= 7.x (with the WHIP muxer) for Intel or Apple-Silicon
# laptops. Runs verify_live.py: WHIP-publish → Cloudflare → watch in a browser.
FROM python:3.12-slim

ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends curl xz-utils ca-certificates \
 && arch="$([ "$TARGETARCH" = "arm64" ] && echo linuxarm64 || echo linux64)" \
 && curl -fsSL "https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-${arch}-gpl.tar.xz" -o /tmp/ff.tar.xz \
 && tar -xf /tmp/ff.tar.xz -C /tmp \
 && cp /tmp/ffmpeg-*/bin/ffmpeg /usr/local/bin/ffmpeg \
 && chmod +x /usr/local/bin/ffmpeg \
 && rm -rf /tmp/ff* \
 && apt-get purge -y xz-utils curl && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*

# sanity: the whip muxer must be present
RUN ffmpeg -hide_banner -muxers 2>/dev/null | grep -q whip || (echo "FATAL: ffmpeg lacks whip muxer" && exit 1)

WORKDIR /app
COPY verify_live.py .
ENTRYPOINT ["python3", "verify_live.py"]
