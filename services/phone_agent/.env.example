# Meridian AI Phone Agent — Environment Variables
# 100% open source — no paid API keys required

# ─── Fonoster (self-hosted SIP) ───────────────────────────
FONOSTER_API_URL=http://localhost:3000
SIP_DOMAIN=sip.yourdomain.com
SERVER_PUBLIC_IP=your.server.ip.address

# ─── SIP Trunk (only external cost — ~$0.004/min) ────────
# VoIP.ms or Telnyx for real PSTN connectivity
# Skip entirely for testing with SIP soft phones
SIP_TRUNK_HOST=voip.ms
SIP_TRUNK_USER=
SIP_TRUNK_PASSWORD=

# ─── Ollama (self-hosted LLM) ────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.3:70b
# Lighter alternatives: llama3.1:8b, qwen2.5:7b

# ─── WhisperLiveKit (self-hosted STT) ────────────────────
WHISPER_MODEL=medium
# Options: base, small, medium, large-v3
WHISPER_DEVICE=auto
# Options: auto, cuda, cpu
WHISPER_COMPUTE_TYPE=int8
# Options: int8 (CPU), float16 (GPU)

# ─── Kokoro TTS (self-hosted TTS) ────────────────────────
KOKORO_VOICE=af_bella
# Voices: af_bella, af_sarah, am_adam, am_michael
KOKORO_SPEED=1.1

# ─── Phone Agent Service ─────────────────────────────────
PHONE_AGENT_PORT=8090
PIPECAT_WS_URL=ws://localhost:8090/ws
LOG_LEVEL=INFO

# ─── Existing Meridian Services ──────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ─── Unified Payments (Stripe Connect) ───────────────────
UNIFIED_PAYMENTS_ENABLED=0
STRIPE_SECRET_KEY=
# Meridian's flat per-order fee, in cents (Case B pricing: 50 = $0.50).
MERIDIAN_SERVICE_FEE_CENTS=50
MERIDIAN_PLATFORM_FEE_BPS=0
# Case B gross-up: add Stripe's estimated processing (2.9% + 30¢) to the
# application fee so the MERCHANT bears card costs in transit — without this,
# destination charges debit processing from Meridian's balance (verified:
# −$0.73/order at a $0.50 fee on a $32 order).
STRIPE_FEE_GROSSUP_ENABLED=1
STRIPE_FEE_BPS=290
STRIPE_FEE_FIXED_CENTS=30

# ─── POS Push Timing ─────────────────────────────────────
# 1 (default): virtually-paid (pay_now) orders reach the POS only AFTER Stripe
# confirms payment — unpaid orders never hit the kitchen. 0: legacy behavior
# (ticket created up front, hold tracked only in the DB).
POS_PUSH_AFTER_PAYMENT=1
